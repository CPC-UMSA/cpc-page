generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TallaPolera {
  S
  M
  L
  XL
  XXL
}

model Division2Registration {
  id              String      @id @default(cuid())
  nombreCompleto  String
  nickname        String
  matriculaPdfUrl String?
  celular         String
  correo          String
  telegramUsuario String
  tallaPolera     TallaPolera
  comentario      String?
  createdAt       DateTime    @default(now())
}

model Division1Registration {
  id                           String   @id @default(cuid())
  nombreEquipo                 String
  participante1Nombre          String
  participante1MatriculaPdfUrl String?
  participante2Nombre          String
  participante2MatriculaPdfUrl String?
  participante3Nombre          String
  participante3MatriculaPdfUrl String?
  reservaNombre                String?
  reservaMatriculaPdfUrl       String?
  celularRepresentante         String
  correoRepresentante          String
  telegramRepresentante        String
  comentario                   String?
  createdAt                    DateTime @default(now())
}
